    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "immer": "^11.1.18",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
